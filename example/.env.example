# Copy to .env.local for local development, or add these in Vercel → Settings → Environment Variables.

# Wati → API Docs: the API endpoint host (no tenant ID) and an access token.
WATI_API_ENDPOINT=https://live-mt-server.wati.io
WATI_ACCESS_TOKEN=

# Any long random string, e.g. `openssl rand -hex 32`.
# Register the webhook in Wati as https://<your-host>/api/webhooks/wati?token=<this value>
WATI_WEBHOOK_SECRET=

# Optional: your WhatsApp Business number (digits only), needed for the `template` command.
WATI_CHANNEL_PHONE_NUMBER=

# Optional locally, recommended on Vercel: Redis keeps button mappings and
# dedupe state across serverless instances. Without it, in-memory state is used.
# KV_URL (set by the Upstash integration) works too.
REDIS_URL=
